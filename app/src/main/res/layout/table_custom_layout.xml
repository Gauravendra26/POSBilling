<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="@dimen/_10sdp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_5sdp"
        >

        <ImageView
            android:id="@+id/imgAlertLogo"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:src="@drawable/logo"
            android:layout_marginVertical="@dimen/_2sdp"
            android:layout_centerVertical="true"
            />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DSOI"
            android:textSize="@dimen/_20sdp"
            android:layout_marginLeft="@dimen/_10sdp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/imgAlertLogo"
            android:fontFamily="@font/proxima"
            android:textColor="@color/black"
            />

    </RelativeLayout>

    <TextView
         android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="* Choose Add Order for more order"
        android:textSize="@dimen/_12sdp"
        android:textStyle="bold"
        android:layout_marginLeft="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_10sdp"
        />
    <TextView
         android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="* Choose Bill for Final Bill"
        android:textSize="@dimen/_12sdp"
        android:textStyle="bold"
        android:layout_marginLeft="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginBottom="16dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginLeft="@dimen/_5sdp"
        >

        <RelativeLayout
            android:id="@+id/rlOrderCancel"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginVertical="@dimen/_5sdp"
            android:background="@drawable/shape_login"
            android:elevation="@dimen/_3sdp"
            android:layout_toLeftOf="@+id/rlCancel"
            android:layout_marginRight="@dimen/_10sdp"
             >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Order Cancel"
                android:textColor="@color/main"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold" />

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rlCancel"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginVertical="@dimen/_5sdp"
            android:background="@drawable/shape_login"
            android:elevation="@dimen/_3sdp"
            android:layout_toLeftOf="@+id/rlPrint"
            android:layout_marginRight="@dimen/_10sdp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Add Order"
                android:textColor="@color/main"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlPrint"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginVertical="@dimen/_5sdp"
            android:background="@drawable/shape_login_button"
            android:elevation="@dimen/_3sdp"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/_5sdp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Bill"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold" />

        </RelativeLayout>


    </RelativeLayout>
</LinearLayout>
